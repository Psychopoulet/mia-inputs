{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-inputs",
		"version": "1.0.0",
		"description": "Keyboard inputs simulator plugin for MIA."
	},
	"paths": {

		"/mia-inputs/public/index.html": {
			"get": {
				"description": "",
				"summary": "Plugin's front",
				"operationId": "getFrontIndex",
				"responses": {
					"200": {
						"description": "Plugin's front",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-inputs/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Plugin's front app",
				"operationId": "getFrontApp",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-inputs/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Plugin's front app map",
				"operationId": "getFrontAppMap",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-inputs/api/descriptor": {
			"get": {
				"description": "",
				"summary": "Plugin's descriptor",
				"operationId": "getPluginDescriptor",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Plugin's descriptor",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-inputs/api/status": {
			"get": {
				"description": "",
				"summary": "Plugin's status",
				"operationId": "getPluginStatus",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Plugin's status",
						"content": {
							"application/json": {
								"schema": {
									"type": "string",
									"enum": [ "ENABLED", "INITIALIZED", "RELEASED" ]
								}
							}
						}
					},
					"404": {
						"description": "The plugin is not enabled (=RELEASED)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-inputs/api/input/key": {
			"put": {
				"description": "",
				"summary": "Execute the input key",
				"operationId": "inputKey",
				"security": [
					{ "bearerAuth": [] }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/InputKey"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Input key done",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-inputs/api/input/string": {
			"put": {
				"description": "",
				"summary": "Execute the input string",
				"operationId": "inputString",
				"security": [
					{ "bearerAuth": [] }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/InputString"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Input string done",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}

	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"PluginName": {
				"type": "string",
				"enum": [ "mia-inputs" ]
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"InputString": {
				"type": "object",
				"description": "Input string (keyboard simulator)",
				"properties": {
					"string": {
						"type": "string",
						"minLength": 1
					},
					"enter": {
						"description": "Add a 'enter' input at the end of the string (default : false)",
						"type": "boolean"
					}
				},
				"required": [ "type", "string" ]
			},
			"InputKey": {
				"type": "object",
				"description": "Input specific key (keyboard simulator)",
				"properties": {
					"key": {
						"anyOf": [
							{
								"type": "string",
								"description": "global key, like a single letter",
								"minLength": 1,
								"maxLength": 1
							},
							{
								"type": "string",
								"description": "specific key, like \"backspace\"",
								"enum": [
									"f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12",
									"f13", "f14", "f15", "f16", "f17", "f18", "f19", "f20", "f21", "f22", "f23", "f24",
									"insert", "home", "pageup", "delete", "end", "pagedown", "scroll_lock",
									"command", "menu", "alt", "right_alt", "control", "left_control", "right_control", "shift", "right_shift",
									"space", "backspace", "enter", "escape", "tab", "up", "down", "left", "right", "printscreen", "capslock",
									"numpad_lock", "numpad_0", "numpad_1", "numpad_2", "numpad_3", "numpad_4", "numpad_5", "numpad_6",
									"numpad_7", "numpad_8", "numpad_9", "numpad_+", "numpad_-", "numpad_*", "numpad_/", "numpad_.",
									"audio_mute", "audio_vol_up", "audio_vol_down", "audio_play", "audio_stop", "audio_pause", "audio_prev",
									"audio_next", "audio_rewind", "audio_forward", "audio_repeat", "audio_random",
									"lights_mon_up", "lights_mon_down", "lights_kbd_toggle", "lights_kbd_up", "lights_kbd_down"
								]
							}
						]
					},
					"alt": {
						"description": "Key + alt (default : false)",
						"type": "boolean"
					},
					"ctrl": {
						"description": "Key + ctrl (default : false)",
						"type": "boolean"
					},
					"shift": {
						"description": "Key + shift (default : false)",
						"type": "boolean"
					},
					"command": {
						"description": "Key + command (default : false) (mac only)",
						"type": "boolean"
					}
				},
				"required": [ "type", "key" ]
			},
			"PushEventPluginInitialized": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInitialized"
			},
			"PushEventPluginReleased": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginReleased"
			},
			"PushEventPluginError": {
                "$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginError"
			}
		}
	},
	"servers": [
		{
			"url": "http://localhost:8000/",
			"description": "test server"
		}
	]
}
